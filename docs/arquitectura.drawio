<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0"><diagram id="arq" name="Arquitectura ROBOTICA"><mxGraphModel dx="1700" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;font style="font-size:22px"&gt;&lt;b&gt;Arquitectura del proyecto ROBOTICA: Usuario + Claude Code + Gemini (Antigravity)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#666666"&gt;Estado al 2026-11-18 · fuente: AGENTS.md, CLAUDE.md, GEMINI.md, PENDIENTES.md, .mcp.json y el contenido real de las carpetas&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1560" height="55" as="geometry"/></mxCell><mxCell id="c3" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;USUARIO · decide y aprueba&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Sube PDF de reglamentos, datasheets, fotos y videos&lt;br&gt;• ÚNICO que pasa un reglamento a estado &amp;#x27;verificado&amp;#x27;&lt;br&gt;• Decide competencias y variante_activa de cada robot&lt;br&gt;• Reparte tareas (modo manual) y aprueba AGENTS.md y tools/&lt;br&gt;• Calibra con el robot real y aprueba el tag de git' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="75" width="400" height="135" as="geometry"/></mxCell><mxCell id="c4" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;CLAUDE CODE · CLI v2.1.323 · cuenta Claude Pro (sin API)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Rol: CONSTRUYE Y VALIDA&lt;/b&gt;&lt;br&gt;• CAD: OpenSCAD, build123d, CadQuery, FreeCAD&lt;br&gt;• Simulación: analítica + MuJoCo (miles de combates) con tests pytest&lt;br&gt;• Firmware PlatformIO · PCB KiCad · reporte HTML (Plotly)&lt;br&gt;• Ciclo de verificación: generar → renderizar → abrir el PNG y describirlo → medir (bbox, volumen, malla cerrada) → corregir&lt;br&gt;&lt;b&gt;Edita: RobotXxx/cad, sim, firmware, pcb · tools/ · genera reports/&lt;/b&gt;&lt;br&gt;Solo lee: reglamentos/ y datasheets/. En componentes.yaml solo añade medidas propias con fuente&lt;br&gt;Reglas: CLAUDE.md → AGENTS.md · modelo según /model (hoy Opus 5.5)&lt;br&gt;Corre en terminal propia o en el Antigravity IDE (extensión instalada)' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FCE4D6;strokeColor=#D97757;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="540" height="270" as="geometry"/></mxCell><mxCell id="c5" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;MCP (misma config en ambos, versiones fijas)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#666666"&gt;Claude: .mcp.json · Gemini: ~/.gemini/config/mcp_config.json&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="240" width="400" height="270" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;openscad 0.6.1&lt;/b&gt;&lt;br&gt;render, measure, validate, export. Solo accede a ROBOTICA&lt;br&gt;&lt;b&gt;PROBADO&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="634" y="300" width="178" height="92" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;kicad-mcp-pro 4.14&lt;/b&gt;&lt;br&gt;25 herramientas SOLO LECTURA (ERC, DRC, BOM, DFM)&lt;br&gt;&lt;b&gt;PROBADO&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="828" y="300" width="178" height="92" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;freecad 0.1.31&lt;/b&gt;&lt;br&gt;Requiere FreeCAD abierto + Start RPC Server&lt;br&gt;&lt;font color="#C62828"&gt;&lt;b&gt;SIN PROBAR&lt;/b&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C62828;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="634" y="402" width="178" height="98" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;blender 2.2.9&lt;/b&gt;&lt;br&gt;Requiere Blender abierto; safe mode, sin telemetría&lt;br&gt;&lt;font color="#C62828"&gt;&lt;b&gt;SIN PROBAR&lt;/b&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C62828;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="828" y="402" width="178" height="98" as="geometry"/></mxCell><mxCell id="c10" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;GEMINI · ANTIGRAVITY IDE + agy CLI · cuenta Google AI Pro&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Rol: LEE, EXTRAE Y AUDITA&lt;/b&gt;&lt;br&gt;• Lee PDF, datasheets, fotos y videos → YAML siempre con fuente (archivo + página)&lt;br&gt;• Llena: reglamento.yaml (lo deja &amp;#x27;pendiente&amp;#x27;), componentes.yaml y robot.yaml&lt;br&gt;• Audita cálculos y reportes: números que violen la física y saltos lógicos → RobotXxx/reports/auditoria-&amp;lt;fecha&amp;gt;.md&lt;br&gt;&lt;b&gt;NO edita cad/, sim/, firmware/, pcb/ ni tools/&lt;/b&gt;&lt;br&gt;&lt;b&gt;NUNCA pasa un reglamento a &amp;#x27;verificado&amp;#x27;&lt;/b&gt;&lt;br&gt;Trabaja solo en el robot que se le indique · usa modelos Gemini por defecto&lt;br&gt;Reglas: GEMINI.md → AGENTS.md' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1060" y="240" width="540" height="270" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;COORDINACIÓN: no se hablan entre sí&lt;/b&gt;&lt;br&gt;Comparten carpeta + reglas + MCP&lt;br&gt;Manual: el usuario reparte las tareas&lt;br&gt;Coordinado: Claude delega por terminal →&lt;br&gt;&lt;b&gt;agy -p &amp;quot;&amp;lt;tarea&amp;gt;&amp;quot; --mode plan (solo lectura) | --mode accept-edits (si debe escribir en su zona)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="532" width="400" height="104" as="geometry"/></mxCell><mxCell id="c12" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;REPOSITORIO COMPARTIDO · D:\DiscoE\ROBOTICA · git, rama main, 1 commit (los 6 PDF de CNR_UNI_2026 aún sin versionar)&lt;/b&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="655" width="1560" height="255" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;Reglas y configuración&lt;/b&gt;&lt;br&gt;AGENTS.md = fuente de verdad&lt;br&gt;CLAUDE.md y GEMINI.md solo apuntan a él&lt;br&gt;.mcp.json · .gitignore&lt;br&gt;PENDIENTES.md (abiertos): cuentas y cuota, probar MCP FreeCAD y Blender, actualizador de Antigravity roto, app de Claude Desktop con error 0x80073D0D&lt;br&gt;&lt;font color="#666666"&gt;docs/historial/: plan viejo, solo referencia&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="695" width="288" height="200" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;reglamentos/ (compartido)&lt;/b&gt;&lt;br&gt;XRobo7s-2026/reglamento.yaml&lt;br&gt;&lt;font color="#C62828"&gt;  estado: pendiente · SIN PDF aún&lt;/font&gt;&lt;br&gt;CNR_UNI_2026/reglamento.yaml&lt;br&gt;&lt;font color="#C62828"&gt;  estado: pendiente · categorias: {}&lt;/font&gt;&lt;br&gt;  6 PDF subidos: Combate, MiniSumo Autónomo, MiniSumo Bluetooth-RC, Bug-Race, Walking-Race, Seguidor de Línea Velocista&lt;br&gt;&lt;b&gt;Gemini extrae → Usuario verifica&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="368" y="695" width="288" height="200" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b&gt;componentes/ (compartido)&lt;/b&gt;&lt;br&gt;componentes.yaml: VACÍO (motores, ruedas, baterías, sensores, drivers...)&lt;br&gt;datasheets/: VACÍO&lt;br&gt;scad/ (modelos 3D) y kicad/ (huellas): VACÍOS&lt;br&gt;&lt;font color="#666666"&gt;Cada valor lleva su fuente (datasheet+página, calibre+fecha) o &amp;#x27;estimado&amp;#x27;. Sin dato = null&lt;/font&gt;&lt;br&gt;&lt;b&gt;Gemini extrae datos · Claude modela scad/kicad&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="676" y="695" width="288" height="200" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;tools/ (compartido)&lt;/b&gt;&lt;br&gt;render.py: .scad → PNG + STL&lt;br&gt;medir_stl.py: bbox, volumen, malla cerrada, masa&lt;br&gt;check_reglamento.py: límite más estricto entre competencias. 0 CUMPLE · 1 NO_CUMPLE · 2 INDETERMINADO&lt;br&gt;fisica/ (vacío): motor DC, tracción, vuelco&lt;br&gt;tests/: test_check_reglamento.py&lt;br&gt;&lt;b&gt;Cambiar algo aquí afecta a todos los robots: avisar y correr pytest&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="984" y="695" width="288" height="200" as="geometry"/></mxCell><mxCell id="c17" value='&lt;b&gt;Entornos y software local&lt;/b&gt;&lt;br&gt;.venv: numpy, scipy, mujoco 4.0, trimesh, build123d, pytest, plotly...&lt;br&gt;.venv-cadquery: CadQuery (no mezclar con build123d)&lt;br&gt;OpenSCAD · FreeCAD 1.1 · KiCad 10 · Blender 5.3 · PrusaSlicer/Orca · MeshLab · Inkscape · PlatformIO&lt;br&gt;&lt;font color="#666666"&gt;Hardware: Ryzen 7 7735HS, 15 GB, RTX 3050, Windows 11&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1292" y="695" width="288" height="200" as="geometry"/></mxCell><mxCell id="c18" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;6 ROBOTS INDEPENDIENTES · un agente no lee ni edita otro robot si el usuario no lo pide · TODOS VACÍOS: competencias: [] · variante_activa: null · masas: null&lt;/b&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1560" height="195" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b&gt;RobotMinisumoBTRC&lt;/b&gt;&lt;br&gt;&lt;font color="#666666"&gt;↔ MiniSumo Bluetooth-RC&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="978" width="240" height="62" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b&gt;RobotMinisumoAutonomo&lt;/b&gt;&lt;br&gt;&lt;font color="#666666"&gt;↔ MiniSumo Autónomo&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="313" y="978" width="240" height="62" as="geometry"/></mxCell><mxCell id="c21" value='&lt;b&gt;RobotCombate&lt;/b&gt;&lt;br&gt;&lt;font color="#666666"&gt;↔ Combate de Robots&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="566" y="978" width="240" height="62" as="geometry"/></mxCell><mxCell id="c22" value='&lt;b&gt;RobotBugRace&lt;/b&gt;&lt;br&gt;&lt;font color="#666666"&gt;↔ Robot Bug-Race&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="819" y="978" width="240" height="62" as="geometry"/></mxCell><mxCell id="c23" value='&lt;b&gt;RobotWalkingRace&lt;/b&gt;&lt;br&gt;&lt;font color="#666666"&gt;↔ Robot Walking-Race&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1072" y="978" width="240" height="62" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b&gt;RobotSeguidorLineaVelocista&lt;/b&gt;&lt;br&gt;&lt;font color="#666666"&gt;↔ Seguidor de Línea Velocista&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1325" y="978" width="240" height="62" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Estructura interna de cada RobotXxx/ (la misma en los 6)&lt;/b&gt;&lt;br&gt;spec/robot.yaml: competencias, variante_activa, masas → Gemini llena datos con fuente; Usuario decide competencias y variante_activa; Claude solo actualiza masas.estimada_g desde el CAD&lt;br&gt;inputs/: fotos, notas, videos → Usuario sube · cad/ sim/ firmware/ pcb/ → Claude construye (Gemini audita sin editar) · reports/ → Claude genera el reporte, Gemini escribe auditoria-*.md · build/ → STL y PNG generados, fuera de git" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="1052" width="1520" height="72" as="geometry"/></mxCell><mxCell id="c26" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;FLUJO DE TRABAJO POR ROBOT (AGENTS.md) · color = quién actúa&lt;/b&gt;&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="1000" height="26" as="geometry"/></mxCell><mxCell id="c27" value='&lt;b&gt;1 · Reglamento&lt;/b&gt;&lt;br&gt;Usuario sube el PDF → Gemini llena reglamento.yaml (pendiente) → Usuario revisa y pasa a &amp;#x27;verificado&amp;#x27;&lt;br&gt;&lt;font color="#C62828"&gt;&lt;b&gt;◄ AQUÍ ESTAMOS: PDF de CNR subidos, YAML sin llenar&lt;/b&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="40" y="1183" width="210" height="150" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;2 · Ingesta&lt;/b&gt;&lt;br&gt;Gemini extrae componentes y specs a componentes.yaml y robot.yaml, con fuente. Usuario fija competencias y variante_activa" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="265" y="1183" width="210" height="150" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;3 · Construcción&lt;/b&gt;&lt;br&gt;Claude: CAD paramétrico con ciclo de verificación → simulación analítica + MuJoCo con tests. Invariantes: empuje ≤ min(motor, μ·N); vuelco con altura real del CM" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FCE4D6;strokeColor=#D97757;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="490" y="1183" width="210" height="150" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;4 · Chequeo de reglamento&lt;/b&gt;&lt;br&gt;check_reglamento.py RobotXxx. Solo CUMPLE cuenta; INDETERMINADO no es aprobado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FCE4D6;strokeColor=#D97757;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="715" y="1183" width="210" height="150" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;5 · Auditoría cruzada&lt;/b&gt;&lt;br&gt;Gemini recibe los archivos (no el razonamiento de Claude) → auditoria-*.md. Claude corrige" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="1183" width="210" height="150" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;6 · Calibración&lt;/b&gt;&lt;br&gt;Usuario mide con el robot real: fricción de llantas, fuerza de empuje y masa. Se ajusta el modelo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1165" y="1183" width="210" height="150" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;7 · Versión&lt;/b&gt;&lt;br&gt;Usuario aprueba → tag de git (RobotXxx/v1.0), nunca carpetas v2/final" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1390" y="1183" width="210" height="150" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="Claude corrige" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;dashed=1;" edge="1" parent="1" source="c31" target="c29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1015" y="1353"/><mxPoint x="535" y="1353"/></Array></mxGeometry></mxCell><mxCell id="c41" value="&lt;b&gt;No pagar API&lt;/b&gt;&lt;br&gt;Solo suscripciones Claude Pro y Google AI Pro. Sin ANTHROPIC/GEMINI/GOOGLE_API_KEY. &amp;#x27;Extra usage&amp;#x27; y &amp;#x27;AI Credit Overages&amp;#x27; apagados" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1375" width="250" height="105" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Verificar siempre&lt;/b&gt;&lt;br&gt;Nada de geometría o número sin generar → renderizar → mirar → medir. Los números finales salen de scripts con tests, no de una IA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="302" y="1375" width="250" height="105" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;Datos con fuente&lt;/b&gt;&lt;br&gt;PDF + página, datasheet, o calibre + fecha. Si no, &amp;#x27;estimado&amp;#x27;. Sin dato = null. Prohibido inventar límites" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="564" y="1375" width="250" height="105" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Independencia&lt;/b&gt;&lt;br&gt;Cada RobotXxx es independiente. Lo compartido (componentes, reglamentos, tools) afecta a todos: avisar y correr pytest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="826" y="1375" width="250" height="105" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Versiones y edición&lt;/b&gt;&lt;br&gt;Tags de git, no carpetas. Variantes como parámetros. Un agente edita un archivo a la vez, con commit entre turnos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1088" y="1375" width="250" height="105" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Licencias&lt;/b&gt;&lt;br&gt;Open source permite facturar. NO sirven licencias de estudiante ni Wokwi comercial. Revisar licencia antes de añadir librería o MCP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1350" y="1375" width="250" height="105" as="geometry"/></mxCell><mxCell id="c47" value="pide / revisa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="142"/></Array></mxGeometry></mxCell><mxCell id="c48" value="pide / revisa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1330" y="142"/></Array></mxGeometry></mxCell><mxCell id="c49" value="sube PDF, datasheets, fotos · verifica reglamentos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B8860B;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.25;entryX=1;entryY=0.2;" edge="1" parent="1" source="c3" target="c12"><mxGeometry x="-0.55" relative="1" as="geometry"><Array as="points"><mxPoint x="1625" y="109"/><mxPoint x="1625" y="706"/></Array></mxGeometry></mxCell><mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c10" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97757;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.75;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="delega" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0.25;entryY=1;" edge="1" parent="1" source="c11" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c54" value="construye y valida" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97757;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.25;exitY=1;entryX=0.1;entryY=0;" edge="1" parent="1" source="c4" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c55" value="lee, extrae, audita" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.75;exitY=1;entryX=0.9;entryY=0;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>